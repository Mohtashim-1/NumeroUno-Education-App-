 "css": ".pa-paper {\n\tfont-family: Arial, Helvetica, sans-serif;\n\tcolor: #4a4a4a;\n\tfont-size: 9pt;\n\t-webkit-print-color-adjust: exact !important;\n\tprint-color-adjust: exact !important;\n}\n.pa-page-1 { page-break-after: always; }\n.pa-page-2 { page-break-before: always; }\n.pa-logo-row { width: 100% !important; border-collapse: collapse !important; margin-bottom: 8px; }\n.pa-logo-row td { border: none !important; background: transparent !important; padding: 0 !important; }\n.pa-hse {\n\twidth: 58px;\n\theight: 58px;\n\tborder: 3px solid #27569d;\n\tbackground: #27569d !important;\n\tcolor: #fff !important;\n\ttext-align: center;\n}\n.pa-main-title { font-size: 18pt; font-weight: 800; text-align: center; }\n.pa-orange-text { color: #f58220; }\n.pa-blue-text { color: #27569d; }\n.pa-subtitle { color: #27569d; font-size: 11pt; font-weight: 700; text-align: center; margin-bottom: 8px; }\n.pa-info { width: 100% !important; border-collapse: collapse !important; table-layout: fixed; margin-bottom: 8px; }\n.pa-info td { border: 1px solid #555 !important; padding: 4px 7px !important; }\n.pa-info-label { width: 18%; background: #27569d !important; color: #fff !important; font-weight: 700; }\n.pa-unit-title { background: #f58220 !important; color: #fff !important; padding: 5px 8px; font-weight: 700; }\n.pa-grid { width: 100% !important; border-collapse: collapse !important; table-layout: fixed; }\n.pa-grid th, .pa-grid td { border: 1px solid #444 !important; }\n.pa-grid th { background: #27569d !important; color: #fff !important; }\n.pa-outcome { background: #27569d !important; color: #fff !important; font-weight: 700; padding: 6px !important; }\n.pa-num { color: #f58220; font-weight: 700; }\n.pa-result { text-align: center; font-weight: 700; text-transform: uppercase; }\n.pa-guidance-label { background: #27569d !important; color: #fff !important; font-weight: 700; text-align: center; }\n.pa-footer-company { color: #27569d; text-align: right; font-weight: 700; }\n.pa-remarks-title, .pa-field-title { color: #27569d; font-weight: 700; text-decoration: underline; }\n.pa-evidence-bar { background: #ddd !important; padding: 7px 10px; }\n.pa-sign-table { width: 100% !important; border-collapse: collapse !important; }\n.pa-sign-table th { background: #f58220 !important; color: #fff !important; }\n.pa-sign-table td { border: 1px solid #555 !important; height: 62px; text-align: center; }\n.pa-sign-img { max-height: 48px; max-width: 150px; }\n",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "ROSPA Learning Outcome Assessment",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<style>\n\n@page {\n    size: A4 portrait;\n    margin: 7mm 8mm 8mm 8mm;\n}\n\n.print-format {\n    padding: 0 !important;\n    margin: 0 !important;\n}\n\n.print-heading,\n.letter-head,\n.print-format-letterhead,\n.letterhead,\n.letter-head-image {\n    display: none !important;\n}\n\n.print-format * {\n    box-sizing: border-box;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n}\n\n.lv-form {\n    font-family: Arial, Helvetica, sans-serif;\n    color: #4b4b4b;\n    font-size: 9pt;\n    line-height: 1.15;\n}\n\n.lv-page-1 {\n    page-break-after: always;\n}\n\n.lv-page-2 {\n    page-break-before: always;\n}\n\n\n/* ================================\n   COLORS\n================================ */\n\n.lv-blue {\n    background: #28579e !important;\n    color: #fff !important;\n}\n\n.lv-orange {\n    background: #f58220 !important;\n    color: #fff !important;\n}\n\n.lv-blue-text {\n    color: #28579e !important;\n}\n\n.lv-orange-text {\n    color: #f58220 !important;\n}\n\n\n/* ================================\n   TOP LOGOS\n================================ */\n\n.lv-logo-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin-bottom: 7px;\n}\n\n.lv-logo-table td {\n    border: none !important;\n    padding: 0 !important;\n    vertical-align: top;\n}\n\n.lv-logo-left {\n    text-align: left;\n}\n\n.lv-logo-right {\n    text-align: right;\n}\n\n.lv-logo {\n    max-height: 58px;\n    max-width: 100px;\n}\n\n\n/* ================================\n   TITLE\n================================ */\n\n.lv-main-title {\n    margin: 2px 0 2px 0;\n    font-size: 21pt;\n    font-weight: 800;\n    line-height: 1;\n    white-space: nowrap;\n}\n\n.lv-subtitle {\n    color: #28579e;\n    font-weight: bold;\n    font-size: 12pt;\n    margin: 5px 0 2px 0;\n}\n\n\n/* ================================\n   META\n================================ */\n\n.lv-meta {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    margin-bottom: 10px;\n}\n\n.lv-meta td {\n    height: 28px;\n    padding: 5px 7px !important;\n    border-bottom: 1px solid #555 !important;\n    vertical-align: middle;\n}\n\n.lv-meta-label {\n    width: 20%;\n    background: #28579e !important;\n    color: #fff !important;\n    font-size: 9pt;\n    font-weight: bold;\n}\n\n.lv-meta-value {\n    width: 30%;\n    background: #fff !important;\n    color: #333 !important;\n}\n\n\n/* ================================\n   UNIT BAR\n================================ */\n\n.lv-unit-title {\n    background: #f58220 !important;\n    color: white !important;\n    border: 1px solid #555;\n    padding: 4px 7px;\n    font-size: 9pt;\n    font-weight: bold;\n}\n\n\n/* ================================\n   MAIN GRID\n================================ */\n\n.lv-grid {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n    margin: 0;\n}\n\n.lv-grid th,\n.lv-grid td {\n    border: 1px solid #4c4c4c !important;\n}\n\n.lv-grid thead th {\n    background: #28579e !important;\n    color: #fff !important;\n    font-size: 8.5pt;\n    font-weight: bold;\n    text-align: left;\n    padding: 5px 7px !important;\n    vertical-align: middle;\n}\n\n.lv-outcome-head {\n    width: 13%;\n}\n\n.lv-criteria-head {\n    width: 68%;\n}\n\n.lv-achieved-head {\n    width: 6%;\n}\n\n.lv-source-head {\n    width: 13%;\n}\n\n\n/* Outcome blue merged cell */\n\n.lv-outcome {\n    background: #28579e !important;\n    color: #fff !important;\n    font-weight: bold;\n    font-size: 9pt;\n    padding: 8px 7px !important;\n    vertical-align: middle !important;\n    text-align: left;\n}\n\n\n/* Criteria rows */\n\n.lv-criterion {\n    padding: 2px 7px !important;\n    line-height: 1.12;\n    vertical-align: top;\n}\n\n.lv-criterion-number {\n    display: inline-block;\n    min-width: 34px;\n    color: #f58220 !important;\n    font-weight: bold;\n}\n\n.lv-achieved {\n    text-align: center;\n    vertical-align: middle !important;\n    font-size: 12pt;\n    color: #28579e;\n}\n\n.lv-source {\n    text-align: center;\n    vertical-align: middle !important;\n    padding: 3px !important;\n}\n\n\n/* ================================\n   GUIDANCE\n================================ */\n\n.lv-guidance-label {\n    background: #28579e !important;\n    color: #fff !important;\n    font-weight: bold;\n    vertical-align: middle !important;\n    padding: 7px !important;\n}\n\n.lv-guidance-text {\n    padding: 7px !important;\n    line-height: 1.15;\n    font-size: 8.5pt;\n}\n\n\n/* ================================\n   FOOTER\n================================ */\n\n.lv-footer-line {\n    border-top: 2px solid #28579e;\n    margin-top: 17px;\n}\n\n.lv-company-footer {\n    text-align: right;\n    font-weight: bold;\n    color: #28579e;\n    font-size: 10.5pt;\n    margin-top: 48px;\n}\n\n\n/* ================================\n   PAGE 2\n================================ */\n\n.lv-page2-content {\n    padding: 0 2px;\n}\n\n.lv-page2-label {\n    color: #28579e !important;\n    font-weight: bold;\n    text-decoration: underline;\n    font-size: 10pt;\n}\n\n.lv-remarks-box {\n    min-height: 165px;\n    padding: 7px 10px;\n}\n\n.lv-source-bar {\n    background: #dedede !important;\n    font-size: 9pt;\n    padding: 7px 12px;\n    margin-bottom: 0;\n}\n\n.lv-page2-box {\n    min-height: 100px;\n    border-bottom: 1px solid #555;\n    padding: 6px 10px;\n}\n\n.lv-training-box {\n    min-height: 150px;\n}\n\n.lv-page2-value {\n    margin-top: 8px;\n}\n\n\n/* Declaration */\n\n.lv-declaration {\n    padding: 8px 10px 13px 10px;\n    font-size: 9pt;\n    line-height: 1.18;\n}\n\n\n/* ================================\n   ASSESSOR\n================================ */\n\n.lv-assessor {\n    width: 100%;\n    border-collapse: collapse;\n    table-layout: fixed;\n}\n\n.lv-assessor th {\n    background: #f58220 !important;\n    color: #fff !important;\n    font-size: 9pt;\n    font-weight: bold;\n    text-align: left;\n    padding: 5px 7px !important;\n    border-right: 1px solid #fff !important;\n}\n\n.lv-assessor td {\n    height: 80px;\n    border: 1px solid #555 !important;\n    padding: 7px !important;\n    vertical-align: middle;\n}\n\n.lv-assessor-name {\n    width: 41%;\n}\n\n.lv-assessor-signature {\n    width: 41%;\n}\n\n.lv-assessor-date {\n    width: 18%;\n}\n\n.lv-signature-img {\n    max-height: 60px;\n    max-width: 160px;\n}\n\n</style>\n\n\n<!-- ============================================================\n     PAGE 1\n============================================================ -->\n\n<div class=\"lv-form lv-page-1\">\n\n\n    <!-- LOGOS -->\n\n    <table class=\"lv-logo-table\">\n        <tr>\n\n            <td class=\"lv-logo-left\">\n\n                {% if doc.hse_logo %}\n                    <img\n                        src=\"{{ doc.hse_logo }}\"\n                        class=\"lv-logo\"\n                    >\n                {% endif %}\n\n            </td>\n\n            <td class=\"lv-logo-right\">\n\n                {% if doc.adnoc_logo %}\n                    <img\n                        src=\"{{ doc.adnoc_logo }}\"\n                        class=\"lv-logo\"\n                    >\n                {% endif %}\n\n            </td>\n\n        </tr>\n    </table>\n\n\n\n    <!-- TITLE -->\n\n    <div class=\"lv-main-title\">\n\n        <span class=\"lv-orange-text\">\n            PRACTICAL ASSESSMENT\n        </span>\n\n        <span class=\"lv-blue-text\">\n            \u2013 LIGHT VEHICLE\n        </span>\n\n    </div>\n\n\n    <div class=\"lv-subtitle\">\n        ADNOC Light Vehicles Assessment form\n    </div>\n\n\n\n    <!-- CANDIDATE INFO -->\n\n    <table class=\"lv-meta\">\n\n        <tr>\n\n            <td class=\"lv-meta-label\">\n                Candidate Name\n            </td>\n\n            <td class=\"lv-meta-value\">\n                {{ doc.candidate_name or \"\" }}\n            </td>\n\n\n            <td class=\"lv-meta-label\" style=\"width:15%;\">\n                Date\n            </td>\n\n            <td\n                class=\"lv-meta-value\"\n                style=\"width:35%;\"\n            >\n\n                {% if doc.assessment_date %}\n\n                    {{\n                        frappe.utils.formatdate(\n                            doc.assessment_date,\n                            \"dd-MM-yyyy\"\n                        )\n                    }}\n\n                {% endif %}\n\n            </td>\n\n        </tr>\n\n\n        <tr>\n\n            <td class=\"lv-meta-label\">\n                Employing company\n            </td>\n\n            <td class=\"lv-meta-value\">\n                {{ doc.employing_company or \"\" }}\n            </td>\n\n\n            <td\n                class=\"lv-meta-label\"\n                style=\"width:15%;\"\n            >\n                Mobile number\n            </td>\n\n            <td\n                class=\"lv-meta-value\"\n                style=\"width:35%;\"\n            >\n                {{ doc.mobile_number or \"\" }}\n            </td>\n\n        </tr>\n\n    </table>\n\n\n\n    <!-- UNIT TITLE -->\n\n    <div class=\"lv-unit-title\">\n        UNIT 5 \u2013 Practical Driving Assessment\n    </div>\n\n\n\n    <!-- MAIN ASSESSMENT TABLE -->\n\n    <table class=\"lv-grid\">\n\n        <thead>\n\n            <tr>\n\n                <th class=\"lv-outcome-head\">\n                    OUTCOMES\n                </th>\n\n                <th class=\"lv-criteria-head\">\n                    CRITERIA\n                </th>\n\n                <th class=\"lv-achieved-head\">\n                </th>\n\n                <th class=\"lv-source-head\">\n                    SOURCE OF<br>EVIDENCE\n                </th>\n\n            </tr>\n\n        </thead>\n\n\n        <tbody>\n\n\n            {#\n               ---------------------------------------------------\n               OUTCOME ROWSPAN LOGIC\n               ---------------------------------------------------\n            #}\n\n            {% set ns = namespace(last_outcome=\"\") %}\n\n\n            {% for row in doc.criteria %}\n\n\n                <tr>\n\n\n                    {% if row.outcome != ns.last_outcome %}\n\n\n                        {% set ns.last_outcome = row.outcome %}\n\n\n                        {% set count = namespace(value=0) %}\n\n\n                        {% for x in doc.criteria %}\n\n                            {% if x.outcome == row.outcome %}\n\n                                {% set count.value = count.value + 1 %}\n\n                            {% endif %}\n\n                        {% endfor %}\n\n\n\n                        <td\n                            class=\"lv-outcome\"\n                            rowspan=\"{{ count.value }}\"\n                        >\n\n                            {{ row.outcome or \"\" }}\n\n                        </td>\n\n\n                    {% endif %}\n\n\n\n                    <!-- CRITERIA -->\n\n                    <td class=\"lv-criterion\">\n\n                        <span class=\"lv-criterion-number\">\n\n                            {% if row.sr_no %}\n                                {{ row.sr_no }}\n                            {% else %}\n                                {{ loop.index }}\n                            {% endif %}\n\n                        </span>\n\n\n                        {{ row.criterion or \"\" }}\n\n                    </td>\n\n\n\n                    <!-- ACHIEVED -->\n\n                    <td class=\"lv-achieved\">\n\n                        {% if row.achieved %}\n\n                            \u2611\n\n                        {% else %}\n\n                            \u2610\n\n                        {% endif %}\n\n                    </td>\n\n\n\n                    <!-- SOURCE -->\n\n                    <td class=\"lv-source\">\n\n                        {{ row.source_of_evidence or \"\" }}\n\n                    </td>\n\n\n                </tr>\n\n\n            {% endfor %}\n\n\n\n            <!-- ASSESSMENT GUIDANCE -->\n\n            <tr>\n\n\n                <td class=\"lv-guidance-label\">\n\n                    Assessment<br>\n                    Guidance\n\n                </td>\n\n\n                <td\n                    colspan=\"3\"\n                    class=\"lv-guidance-text\"\n                >\n\n                    This outcome specifies the standard of competence\n                    required by the driver, through a number of practical\n                    outcomes specified in Outcome 1 of Unit 5.\n\n                    Learners must successfully complete all practical\n                    exercises to achieve this Unit.\n\n                    <br><br>\n\n                    Records of methods used, and assessment results\n                    must be maintained.\n\n                </td>\n\n\n            </tr>\n\n\n        </tbody>\n\n    </table>\n\n\n\n    <!-- PAGE 1 BOTTOM -->\n\n    <div class=\"lv-footer-line\"></div>\n\n\n    <div class=\"lv-company-footer\">\n        Abu Dhabi National Oil Company\n    </div>\n\n\n</div>\n\n\n\n<!-- ============================================================\n     PAGE 2\n============================================================ -->\n\n<div class=\"lv-form lv-page-2\">\n\n\n    <!-- LOGOS -->\n\n    <table class=\"lv-logo-table\">\n\n        <tr>\n\n            <td class=\"lv-logo-left\">\n\n                {% if doc.hse_logo %}\n\n                    <img\n                        src=\"{{ doc.hse_logo }}\"\n                        class=\"lv-logo\"\n                    >\n\n                {% endif %}\n\n            </td>\n\n\n            <td class=\"lv-logo-right\">\n\n                {% if doc.adnoc_logo %}\n\n                    <img\n                        src=\"{{ doc.adnoc_logo }}\"\n                        class=\"lv-logo\"\n                    >\n\n                {% endif %}\n\n            </td>\n\n        </tr>\n\n    </table>\n\n\n\n    <div class=\"lv-page2-content\">\n\n\n        <!-- REMARKS -->\n\n        <div class=\"lv-page2-label\">\n            Remarks:\n        </div>\n\n\n        <div class=\"lv-remarks-box\">\n\n            {{ doc.remarks or \"\" }}\n\n        </div>\n\n\n\n        <!-- SOURCE OF EVIDENCE -->\n\n        <div class=\"lv-source-bar\">\n\n            Source of Evidence:\n\n            O \u2013 Observation\n\n            &nbsp;&nbsp;\n\n            S- Simulation\n\n            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\n\n            Q \u2013 Questioning\n\n            &nbsp;&nbsp;\n\n            W - Witness\n\n        </div>\n\n\n\n        <!-- LEARNER NAME -->\n\n        <div class=\"lv-page2-box\">\n\n            <div class=\"lv-page2-label\">\n                Learner Name:\n            </div>\n\n\n            <div class=\"lv-page2-value\">\n\n                {{ doc.candidate_name or \"\" }}\n\n            </div>\n\n        </div>\n\n\n\n        <!-- COMPANY -->\n\n        <div class=\"lv-page2-box\">\n\n            <div class=\"lv-page2-label\">\n                Company:\n            </div>\n\n\n            <div class=\"lv-page2-value\">\n\n                {{ doc.employing_company or \"\" }}\n\n            </div>\n\n        </div>\n\n\n\n        <!-- TRAINING -->\n\n        <div class=\"lv-page2-box lv-training-box\">\n\n            <div class=\"lv-page2-label\">\n\n                Training and Development Needs:\n\n            </div>\n\n\n            <div class=\"lv-page2-value\">\n\n                {{\n                    doc.training_development_needs\n                    or \"\"\n                }}\n\n            </div>\n\n        </div>\n\n\n\n        <!-- DECLARATION -->\n\n        <div class=\"lv-declaration\">\n\n            Declaration: The person named was assessed by me\n            against the standards of performance specified in\n            this document and in accordance with the assessment\n            guidance.\n\n            <br>\n\n\n            I consider that the above person\n\n            {% if doc.achievement_status == \"Has achieved\" %}\n\n                <b>has</b>\n\n            {% else %}\n\n                <b>has not</b>\n\n            {% endif %}\n\n            achieved a sufficient level of understanding of the\n            Light Vehicle Professional Driving Theory course.\n\n            <br>\n\n\n            {% if doc.requires_further_training %}\n\n                I consider that the above person requires further\n                training and development in addition to that which\n                is installation specific.\n\n            {% endif %}\n\n            <br>\n\n            * delete whichever does not apply\n\n        </div>\n\n\n\n        <!-- ASSESSOR -->\n\n        <table class=\"lv-assessor\">\n\n            <thead>\n\n                <tr>\n\n                    <th class=\"lv-assessor-name\">\n                        Assessor's Name\n                    </th>\n\n                    <th class=\"lv-assessor-signature\">\n                        Signature\n                    </th>\n\n                    <th class=\"lv-assessor-date\">\n                        Date\n                    </th>\n\n                </tr>\n\n            </thead>\n\n\n            <tbody>\n\n                <tr>\n\n                    <td>\n\n                        {{ doc.assessor_name or \"\" }}\n\n                    </td>\n\n\n                    <td style=\"text-align:center;\">\n\n                        {% if doc.assessor_signature %}\n\n                            <img\n                                src=\"{{ doc.assessor_signature }}\"\n                                class=\"lv-signature-img\"\n                            >\n\n                        {% endif %}\n\n                    </td>\n\n\n                    <td>\n\n                        {% if doc.assessor_date %}\n\n                            {{\n                                frappe.utils.formatdate(\n                                    doc.assessor_date,\n                                    \"dd-MM-yyyy\"\n                                )\n                            }}\n\n                        {% endif %}\n\n                    </td>\n\n                </tr>\n\n            </tbody>\n\n        </table>\n\n\n\n        <div\n            class=\"lv-footer-line\"\n            style=\"margin-top:30px;\"\n        ></div>\n\n\n        <div class=\"lv-company-footer\">\n            Abu Dhabi National Oil Company\n        </div>\n\n\n    </div>\n\n</div>",
