 "font_size": 14,
 "html": "<meta name=\"pdfkit-page-size\" content=\"86mm x 54mm\">\n<meta name=\"pdfkit-orientation\" content=\"Landscape\">\n\n<style>\n@page {\n  size: 86mm 54mm;\n  margin: 0;\n}\n\n.print-format {\n  padding: 0 !important;\n  margin: 0 !important;\n}\n\nhtml,\nbody {\n  width: 86mm !important;\n  height: 54mm !important;\n  margin: 0 !important;\n  padding: 0 !important;\n  overflow: hidden !important;\n  font-family: Arial, sans-serif;\n}\n\n/* MAIN CARD */\n.card {\n  position: relative;\n  width: 86mm;\n  height: 54mm;\n  margin: 0 !important;\n  padding: 3mm;\n  box-sizing: border-box;\n  overflow: hidden;\n  border: 0.5mm solid #0046a6;\n  border-radius: 5px;\n}\n\n/* COMMON TABLES */\n.header-table,\n.body-table {\n  width: 100%;\n  margin: 0 !important;\n  border-collapse: collapse !important;\n  border-spacing: 0 !important;\n}\n\n.header-table td,\n.body-table td {\n  padding: 0 !important;\n  vertical-align: top !important;\n}\n\n/* HEADER COMPANY LOGO */\n.header-logo {\n  width: 9mm;\n  padding-bottom: 1mm !important;\n  vertical-align: middle !important;\n}\n\n.header-logo img {\n  width: 8mm;\n  height: 8mm;\n  display: block;\n  object-fit: contain;\n}\n\n/* HEADER COMPANY NAME */\n.header-title {\n  padding-left: 1mm !important;\n  padding-right: 1mm !important;\n  padding-bottom: 1mm !important;\n  vertical-align: middle !important;\n  font-size: 6pt;\n  font-weight: 900;\n  line-height: 1.05;\n  color: #114ad6;\n  text-align: left;\n  text-transform: uppercase;\n}\n\n/* COURSE LOGO IN HEADER */\n.header-course-logo {\n  width: 15mm;\n  padding-bottom: 1mm !important;\n  vertical-align: middle !important;\n  text-align: right;\n}\n\n.header-course-logo img {\n  width: 14mm;\n  height: 8mm;\n  max-width: 14mm;\n  max-height: 8mm;\n  display: block;\n  margin-left: auto;\n  object-fit: contain;\n}\n\n/* SPACE BEFORE HORIZONTAL LINE */\n.header-line td {\n  height: 1mm !important;\n  line-height: 1mm !important;\n  border-bottom: 0.25mm solid #114ad6;\n}\n\n/* BODY */\n.body-table {\n  margin-top: 0.8mm !important;\n}\n\n.center-cell {\n  padding: 0 !important;\n  vertical-align: top !important;\n  text-align: center;\n}\n\n.center-block {\n  margin-top: 0.4mm;\n}\n\n.center-name {\n  margin: 0 0 0.4mm 0;\n  font-size: 7.6pt;\n  font-weight: 800;\n  line-height: 1.05;\n  text-transform: uppercase;\n}\n\n.center-subtext {\n  margin: 0 0 0.6mm 0;\n  font-size: 5pt;\n  line-height: 1.1;\n}\n\n.course-title {\n  margin: 0 0 0.4mm 0;\n  font-size: 5.2pt;\n  font-weight: 900;\n  line-height: 1.1;\n  text-transform: uppercase;\n}\n\n.course-desc {\n  margin: 0 0 0.5mm 0;\n  font-size: 5.2pt;\n  line-height: 1.1;\n}\n\n.center-cell p {\n  margin: 0.28mm 0;\n  font-size: 5.3pt;\n  line-height: 1.15;\n}\n\n/* QR CODE */\n.qr-cell {\n  width: 16mm;\n  padding: 0 !important;\n  vertical-align: top !important;\n  text-align: right;\n}\n\n.qr-cell img {\n  width: 16mm;\n  height: 16mm;\n  display: block;\n  margin-left: auto;\n}\n\n/* FOOTER */\n.footer {\n  margin-top: 0.6mm;\n  text-align: center;\n}\n\n.footer img {\n  width: 100% !important;\n  max-width: 100% !important;\n  height: 9mm !important;\n  display: block;\n  margin: 0 auto;\n  object-fit: contain;\n}\n</style>\n\n{# ========================================================= #}\n{# COURSE INFORMATION                                        #}\n{# ========================================================= #}\n\n{% set course_doc = frappe.get_doc(\"Course\", doc.course) %}\n\n{% if course_doc.logo %}\n  {% if course_doc.logo.startswith(\"http\") %}\n    {% set course_logo_url = course_doc.logo %}\n  {% else %}\n    {% set course_logo_url = frappe.utils.get_url(course_doc.logo) %}\n  {% endif %}\n{% else %}\n  {% set course_logo_url = None %}\n{% endif %}\n\n\n{# ========================================================= #}\n{# INSTRUCTOR INFORMATION                                    #}\n{# ========================================================= #}\n\n{% set instructor = frappe.db.get_value(\n  \"Student Group Instructor\",\n  {\"parent\": doc.student_group},\n  \"instructor\"\n) %}\n\n{% if instructor %}\n  {% set inst = frappe.get_doc(\"Instructor\", instructor) %}\n{% else %}\n  {% set inst = None %}\n{% endif %}\n\n\n{# ========================================================= #}\n{# STUDENT PHOTO                                              #}\n{# ========================================================= #}\n\n{% set student_image = frappe.db.get_value(\n  \"Student\",\n  doc.student,\n  \"image\"\n) %}\n\n{% set fallback_photo = doc.student_photo %}\n\n{% if student_image %}\n  {% set photo = student_image %}\n{% elif fallback_photo %}\n  {% set photo = fallback_photo %}\n{% else %}\n  {% set photo = None %}\n{% endif %}\n\n{% if photo %}\n\n  {% if photo.startswith(\"http\") %}\n    {% set raw_photo_url = photo %}\n  {% else %}\n    {% set raw_photo_url = frappe.utils.get_url(photo) %}\n  {% endif %}\n\n  {% if \"/files/\" in raw_photo_url %}\n    {% set photo_parts = raw_photo_url.split(\"/files/\", 1) %}\n    {% set photo_url =\n      photo_parts[0]\n      ~ \"/files/\"\n      ~ (photo_parts[1] | urlencode)\n    %}\n  {% else %}\n    {% set photo_url = raw_photo_url %}\n  {% endif %}\n\n{% else %}\n  {% set photo_url = None %}\n{% endif %}\n\n\n<div class=\"card\">\n\n  <!-- HEADER -->\n  <table class=\"header-table\">\n    <tr>\n\n      <!-- COMPANY LOGO -->\n      <td class=\"header-logo\">\n        <img\n          src=\"/files/Screenshot from 2025-07-15 08-45-36.png\"\n          alt=\"Company Logo\"\n        >\n      </td>\n\n      <!-- COMPANY NAME -->\n      <td class=\"header-title\">\n        NUMERO UNO TRAINING &amp; CONSULTING LLC\n      </td>\n\n      <!-- COURSE / ACCREDITATION LOGO -->\n      <td class=\"header-course-logo\">\n        {% if course_logo_url %}\n          <img\n            src=\"{{ course_logo_url }}\"\n            alt=\"Course Logo\"\n          >\n        {% endif %}\n      </td>\n\n    </tr>\n\n    <!-- HORIZONTAL LINE -->\n    <tr class=\"header-line\">\n      <td colspan=\"3\"></td>\n    </tr>\n  </table>\n\n\n  <!-- STUDENT PHOTO -->\n  {% if photo_url %}\n    <div style=\"\n      position: absolute;\n      left: 3mm;\n      top: 13.5mm;\n      width: 16mm;\n      height: 20mm;\n      box-sizing: border-box;\n      overflow: hidden;\n      background: #ffffff;\n      border: 0.35mm solid #0046a6;\n    \">\n      <img\n        src=\"{{ photo_url }}\"\n        alt=\"Student Photo\"\n        style=\"\n          width: 100%;\n          height: 100%;\n          display: block;\n          object-fit: cover;\n        \"\n      >\n    </div>\n  {% endif %}\n\n\n  <!-- BODY -->\n  <table class=\"body-table\">\n    <tr>\n\n      {% if photo_url %}\n        <td\n          class=\"center-cell\"\n          style=\"\n            padding-left: 19mm !important;\n            padding-right: 1mm !important;\n          \"\n        >\n      {% else %}\n        <td\n          class=\"center-cell\"\n          style=\"\n            padding-left: 0 !important;\n            padding-right: 1mm !important;\n          \"\n        >\n      {% endif %}\n\n          <div class=\"center-block\">\n\n            <div class=\"center-name\">\n              {{ doc.student_name }}\n            </div>\n\n            <div class=\"center-subtext\">\n              has successfully completed the training\n            </div>\n\n            <div class=\"course-title\">\n              {{ doc.course }}\n\n              {% if doc.custom_level %}\n                {{ doc.custom_level }}\n              {% endif %}\n            </div>\n\n            {% if course_doc.description %}\n              <div class=\"course-desc\">\n                {{ course_doc.description }}\n              </div>\n            {% endif %}\n\n            <p>\n              <strong>No:</strong>\n              {{ doc.name }}\n            </p>\n\n            {% if doc.custom_include_company == 1 %}\n              <p>\n                <strong>Customer:</strong>\n                {{ frappe.db.get_value(\n                  \"Student\",\n                  doc.student,\n                  \"customer_name\"\n                ) or \"\" }}\n              </p>\n            {% endif %}\n\n            {% if inst and inst.instructor_name %}\n              <p>\n                <strong>Instructor:</strong>\n                {{ inst.instructor_name }}\n              </p>\n            {% endif %}\n\n            {% if doc.course_start_date %}\n              <p>\n                <strong>Course Date:</strong>\n                {{ frappe.utils.formatdate(doc.course_start_date) }}\n\n                {% if doc.course_end_date %}\n                  to {{ frappe.utils.formatdate(doc.course_end_date) }}\n                {% endif %}\n              </p>\n            {% endif %}\n\n            {% if doc.certificate_validity_date %}\n              <p>\n                <strong>Expiry Date:</strong>\n                {{ frappe.utils.formatdate(\n                  doc.certificate_validity_date\n                ) }}\n              </p>\n            {% endif %}\n\n            {% if doc.custom_opito_learner_no %}\n              <p>\n                <strong>Learner No:</strong>\n                {{ doc.custom_opito_learner_no }}\n              </p>\n            {% endif %}\n\n            {% if doc.custom_unique_certificate_no %}\n              <p>\n                <strong>Unique Certificate No:</strong>\n                {{ doc.custom_unique_certificate_no }}\n              </p>\n            {% endif %}\n\n          </div>\n        </td>\n\n\n      <!-- QR CODE -->\n      <td class=\"qr-cell\">\n\n        {% set base_url = \"https://erpnext.nutc.cloud\" %}\n\n        {% set verify_url = get_public_verification_url(doc.name) %}\n\n        <img\n          src=\"{{ verify_url | qr_code }}\"\n          alt=\"Certificate Verification QR Code\"\n        >\n\n      </td>\n\n    </tr>\n  </table>\n\n\n  <!-- FOOTER -->\n  <div class=\"footer\">\n    <img\n      src=\"/files/FOOTER.png\"\n      alt=\"Accreditation Logos\"\n    >\n  </div>\n\n</div>",
